{
  "permissions": {
    "allow": [
      "Bash(pnpm test:*)",
      "Bash(pnpm verify)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm e2e:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": ["Bash(git push --force:*)", "Bash(vercel --prod:*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | grep -E '\\.(ts|tsx|css|json|md)$' | xargs -r pnpm exec prettier --write --log-level warn || true"
          }
        ]
      }
    ]
  }
}
